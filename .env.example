# Google Sheets Integration
# Follow the setup guide in GOOGLE_SHEETS_SETUP.md to get these URLs

# Contact form submissions endpoint
# Get this URL from: Google Sheet > Extensions > Apps Script > Deploy > Copy URL
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/d/YOUR_CONTACT_FORM_SCRIPT_ID/usercontent

# Newsletter signups endpoint
# Get this URL from: Google Sheet > Extensions > Apps Script > Deploy > Copy URL
VITE_GOOGLE_NEWSLETTER_SCRIPT_URL=https://script.google.com/macros/d/YOUR_NEWSLETTER_SCRIPT_ID/usercontent

# Example with actual placeholder URLs (replace with your real URLs):
# VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/d/AKfycbzABCDEFG123456/usercontent
# VITE_GOOGLE_NEWSLETTER_SCRIPT_URL=https://script.google.com/macros/d/AKfycbzXYZ789012345/usercontent
